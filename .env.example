# Local development only. Change credentials before hosting.
POSTGRES_PORT=55432
POSTGRES_DB=career_quest
POSTGRES_USER=career_quest
POSTGRES_PASSWORD=career_quest_dev
# Use 0.0.0.0 only when testing from a phone on a trusted LAN.
API_BIND_HOST=127.0.0.1
# Browser access from a phone on the same Wi-Fi.
WEB_BIND_HOST=0.0.0.0
# Server-side explanation adapter. Empty key enables template fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=7
LLM_ENABLED=true
LLM_PROVIDER=openai
# Set LLM_PROVIDER=ollama and start the gpu profile to use the server's NVIDIA GPU.
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=90
